# Copy it into app-plugins.env only if you want to install a theme or plugins.

theme_repo=git@bitbucket.org:mycompany/my_theme_repo.git
repo1=git@bitbucket.org:mycompany/cool_plugins.git
repo2=git@bitbucket.org:mycompany/even_cooler_plugins.git

GISCUBE_PLUGINS_REPOS=${theme_repo},${repo1}

giscube_theme=my_theme_repo/my_theme
plugin1=cool_plugins/advanced_search
plugin2=even_cooler_plugins/marquee
plugin3=even_cooler_plugins/make_unicorns

GISCUBE_PLUGINS_PATHS=${giscube_theme},${plugin1},${plugin2},${plugin3}

# Host user/group for proper file ownership (DO NOT CHANGE)
HOST_UID=$(id -u)
HOST_GID=$(id -g)
